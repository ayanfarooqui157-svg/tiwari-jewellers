# ========================================================
# Tiwari Jewellers - Frontend Environment Configuration
# ========================================================

# In local development:
# Leave VITE_API_URL empty to use Vite's dev proxy (http://localhost:5000)
# VITE_API_URL=

# In production deployment (e.g. Vercel):
# Set this in your Vercel Project Settings > Environment Variables to your live backend:
# VITE_API_URL=https://tiwari-jewellers-api.onrender.com

